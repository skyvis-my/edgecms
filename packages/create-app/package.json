{
  "name": "create-edgecms-app",
  "version": "0.2.0",
  "description": "CLI scaffolding tool to create and bootstrap EdgeCMS starter applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-edgecms-app": "./dist/index.js"
  },
  "files": [
    "README.md",
    "dist",
    "templates/starter"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun scripts/build.ts",
    "check:package": "bun scripts/check-package.ts",
    "prepack": "bun scripts/prepare-pack.ts && bun scripts/build.ts",
    "pretest": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
