{
  "name": "@edgecms/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "EdgeCMS runtime package — real Worker fetch handler, Eden contract types, and bootstrap entrypoint for Cloudflare Workers consumers.",
  "type": "module",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun scripts/build.mjs",
    "typecheck": "bun scripts/build.mjs --noEmit",
    "check": "bun scripts/build.mjs && bun scripts/check-package.mjs",
    "prepack": "bun scripts/build.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@elysiajs/eden": "1.4.6",
    "@elysiajs/openapi": "1.4.14",
    "elysia": "1.4.29",
    "typescript": "5.9.3"
  }
}
