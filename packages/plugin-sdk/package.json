{
  "name": "@edgecms/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Type-safe authoring contracts for trusted EdgeCMS plugins.",
  "type": "module",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --noEmit",
    "check": "node scripts/build.mjs && node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
