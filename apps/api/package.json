{
  "name": "edgecms-api",
  "description": "EdgeCMS API Worker - Content Management System powered by ElysiaJS on Cloudflare Workers",
  "version": "0.1.0",
  "license": "MIT",
  "module": "src/main.ts",
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./contract": "./src/contract.ts",
    "./app": "./src/app.ts",
    "./env": "./src/env.ts",
    "./runtime/bootstrap": "./src/runtime/bootstrap.ts",
    "./plugins/plugin-loader": "./src/plugins/plugin-loader.ts",
    "./plugins/plugin-registry": "./src/plugins/plugin-registry.ts",
    "./observability/metrics": "./src/observability/metrics.ts"
  },
  "scripts": {
    "dev": "bun ../../scripts/prepare-local-dev.ts && cf dev",
    "build:worker": "bun scripts/build-worker.ts",
    "build": "tsc --noEmit && bun run build:worker",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "deploy": "bun run build:worker && cf deploy",
    "deploy:staging": "bun run build:worker && cf deploy --mode staging",
    "deploy:production": "bun run build:worker && cf deploy --mode production",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .wrangler .cloudflare",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxlint --fix .",
    "format:check": "oxlint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/cf.mjs d1 migrations apply \"$D1_DATABASE_ID\" --dir drizzle/migrations",
    "db:seed:smoke": "bun ../../scripts/seed-smoke-db.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:local": "drizzle-kit studio --config=drizzle.local.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.124",
    "@casl/ability": "^6.8.1",
    "@edgecms/plugin-sdk": "workspace:*",
    "@edgecms/schemas": "workspace:*",
    "@elysia/openapi": "^2.0.0-beta.4",
    "@sinclair/typebox": "^0.34.52",
    "ai": "^6.0.301",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "elysia": "^2.0.0-beta.30",
    "graphql": "^17.0.2",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@libsql/client": "^0.17.4",
    "@types/node": "25.1.0",
    "cf": "^1.0.0-beta.14",
    "drizzle-kit": "0.31.11",
    "oxlint": "^1.88.0",
    "typescript": "5.9.3",
    "wrangler": "^4.148.0"
  },
  "trustedDependencies": [
    "oxlint"
  ]
}
