{
  "name": "edgecms-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxlint --fix .",
    "format:check": "oxlint .",
    "check:no-axios": "if grep -RInE \"@/lib/api-client|from 'axios'|from \\\"axios\\\"\" src; then echo 'Found forbidden axios/api-client imports'; exit 1; fi",
    "test": "bun test --isolate src",
    "test:coverage": "bun test --isolate --coverage src",
    "test:watch": "bun test --isolate --watch src",
    "test:e2e": "playwright test",
    "test:e2e:live": "E2E_LIVE_API=1 E2E_LIVE_PERSISTED=1 playwright test",
    "test:e2e:integration-live": "E2E_LIVE_API=1 playwright test e2e/live-api.integration.spec.ts",
    "test:e2e:live-persisted": "E2E_LIVE_PERSISTED=1 playwright test e2e/live-persisted.spec.ts",
    "test:e2e:prd-smoke": "playwright test e2e/prd-smoke.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual-chrome.spec.ts",
    "preview": "vite preview",
    "knip": "knip --include dependencies,unlisted,binaries --no-config-hints"
  },
  "dependencies": {
    "@elysiajs/eden": "1.4.6",
    "@floating-ui/dom": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-direction": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "edgecms-api": "workspace:*",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.561.0",
    "react": "^19.3.0",
    "react-day-picker": "9.12.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "knip": "^6.40.0",
    "oxlint": "^1.87.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
