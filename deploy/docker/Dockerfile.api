# EdgeCMS API — OSS / Docker hosting path (Bun + Postgres/SQLite adapters).
# Cloudflare Workers image is NOT this file; Workers still use wrangler deploy.
FROM oven/bun:1.4.2-alpine AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/
COPY packages/schemas/package.json packages/schemas/
COPY packages/client/package.json packages/client/
COPY packages/plugin-sdk/package.json packages/plugin-sdk/
COPY packages/runtime/package.json packages/runtime/
COPY packages/create-app/package.json packages/create-app/
RUN bun install --frozen-lockfile

FROM deps AS build-admin
COPY . .
RUN bun run build:admin

FROM deps AS build-hosting
COPY . .
RUN bun run --filter edgecms-api hosting:build

FROM oven/bun:1.4.2-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY package.json bun.lock bunfig.toml ./
COPY apps/api ./apps/api
COPY packages ./packages
COPY --from=build-admin /app/apps/admin/dist ./apps/admin/dist
COPY --from=build-hosting /app/apps/api/dist-hosting ./apps/api/dist-hosting

WORKDIR /app/apps/api
ENV ADMIN_DIST_DIR=/app/apps/admin/dist
ENV PORT=8787
ENV HOST=0.0.0.0
ENV DATABASE_DRIVER=postgres
ENV CACHE_DRIVER=memory
ENV MEDIA_DRIVER=filesystem
ENV MEDIA_DATA_DIR=/data/media
ENV SQLITE_PATH=/data/edgecms.sqlite
EXPOSE 8787
VOLUME ["/data"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD bun -e 'fetch("http://127.0.0.1:8787/api/health/live").then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))'
CMD ["bun", "dist-hosting/server.js"]
