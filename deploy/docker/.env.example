# Copy to .env and fill secrets before `docker compose up`.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_HS256_SECRET=
BASE_URL=http://localhost:8787
SIGNUP_POLICY=disabled
SUPER_ADMIN_EMAILS=admin@example.com
SUPER_ADMIN_REQUIRE_MFA=true

POSTGRES_USER=edgecms
POSTGRES_PASSWORD=edgecms
POSTGRES_DB=edgecms
POSTGRES_PORT=5432

API_PORT=8787
ADMIN_PORT=8080

# Cache: default memory (single replica). For multi-replica / shared CACHE:
#   CACHE_DRIVER=redis
#   REDIS_URL=redis://redis:6379
#   docker compose ... --profile redis up --build
# Redis defaults to two-tier: L1 in-process memory + L2 Redis (read-through /
# write-through). Optional toggles:
#   CACHE_L1_ENABLED=true          # false = Redis-only
#   CACHE_L1_TTL_SECONDS=30
#   CACHE_L1_MAX_TTL_SECONDS=60
#   CACHE_WRITE_MODE=write-through # or write-invalidate
# Or host/port/password instead of URL:
#   REDIS_HOST=redis
#   REDIS_PORT=6379
#   REDIS_PASSWORD=
#   REDIS_DB=0
# Unset REDIS_* (and CACHE_DRIVER=memory or unset) → in-process memory KV.
CACHE_DRIVER=memory
# REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6379

MEDIA_DRIVER=s3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=edgecms-media
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# Public CDN / custom-domain origin (no path). Distinct from S3_ENDPOINT.
# Local MinIO without a CDN: leave unset to serve via API public asset routes,
# or put nginx/Cloudflare in front of MinIO and set CDN_BASE_URL to that origin.
CDN_BASE_URL=
# Legacy alias (used when CDN_BASE_URL is empty):
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8787

# Optional Microsoft Entra ID (Azure AD) admin OIDC — same vars as Workers.
# Reply URL to register: ${BASE_URL}/api/auth/callback/microsoft
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=common
# Optional ops echo (must match computed reply URL when set):
# ENTRA_REDIRECT_URI=http://localhost:8787/api/auth/callback/microsoft
# SSO_MODE=entra
# SSO_LOCAL_AUTH_LOCKOUT=false
# SSO_BREAK_GLASS_LOCAL=true
# SSO_ROLE_MAP=Admin=owner,domain:@contoso.com=member
# SSO_DEFAULT_TENANT_SLUG=
