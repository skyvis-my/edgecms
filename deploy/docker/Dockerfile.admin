# Optional standalone admin static image (nginx). Prefer the API image which
# already serves apps/admin/dist via the ASSETS binding stand-in.
FROM oven/bun:1.4.2-alpine AS build
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/
COPY packages/schemas/package.json packages/schemas/
COPY packages/client/package.json packages/client/
COPY packages/plugin-sdk/package.json packages/plugin-sdk/
COPY packages/runtime/package.json packages/runtime/
COPY packages/create-app/package.json packages/create-app/
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build:admin

FROM nginx:1.27-alpine
COPY deploy/docker/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1
